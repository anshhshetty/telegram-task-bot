    {
      "parameters": {
        "jsCode": "const TZ = 'Asia/Kolkata';\nconst DEFAULT_HOUR = 10;\nconst DURATION_MIN = 30;\n\nconst msg = $input.first().json.message;\nconst chatId = msg.chat.id;\nlet text = (msg.text || '').replace(/^\\/task(@\\w+)?/i, '').trim();\nconst now = DateTime.now().setZone(TZ);\n\nconst fail = (error) => [{ json: { ok: false, chatId, error } }];\nif (!text) return fail('Usage: /task Call Safexpress tomorrow 3pm');\n\nconst take = (re) => {\n  const m = text.match(re);\n  if (m) text = text.replace(m[0], ' ');\n  return m;\n};\n\nconst MONTHS = 'january|february|march|april|may|june|july|august|september|october|november|december|jan|feb|mar|apr|jun|jul|aug|sept|sep|oct|nov|dec';\nconst monthNum = (s) => ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'].indexOf(s.slice(0, 3).toLowerCase()) + 1;\nconst DAYS = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];\n\nfunction makeDate(day, month, year) {\n  const y = year ? (year.length === 2 ? 2000 + Number(year) : Number(year)) : now.year;\n  let d = DateTime.fromObject({ year: y, month, day }, { zone: TZ });\n  if (!year && d.isValid && d < now.startOf('day')) d = d.plus({ years: 1 });\n  return d;\n}\n\nlet hour = null, minute = 0, m;\nif ((m = take(/\\b(?:at\\s+)?(\\d{1,2})(?:[:.](\\d{2}))?\\s*(am|pm)\\b/i))) {\n  hour = (Number(m[1]) % 12) + (m[3].toLowerCase() === 'pm' ? 12 : 0);\n  minute = m[2] ? Number(m[2]) : 0;\n} else if ((m = take(/\\b(?:at\\s+)?([01]?\\d|2[0-3]):([0-5]\\d)\\b/))) {\n  hour = Number(m[1]);\n  minute = Number(m[2]);\n}\n\nlet date = null;\nif (take(/\\b(?:on\\s+)?day after tomorrow\\b/i)) {\n  date = now.plus({ days: 2 });\n} else if (take(/\\b(?:on\\s+)?(?:tomorrow|tmrw|tmr)\\b/i)) {\n  date = now.plus({ days: 1 });\n} else if (take(/\\b(?:on\\s+)?today\\b/i)) {\n  date = now;\n} else if ((m = take(new RegExp(`\\\\b(?:on\\\\s+)?(?:next\\\\s+)?(${DAYS.join('|')})\\\\b`, 'i')))) {\n  const target = DAYS.indexOf(m[1].toLowerCase()) + 1;\n  date = now.plus({ days: ((target - now.weekday + 7) % 7) || 7 });\n} else if ((m = take(new RegExp(`\\\\b(?:on\\\\s+)?(\\\\d{1,2})(?:st|nd|rd|th)?\\\\s+(${MONTHS})\\\\b(?:\\\\s+(\\\\d{4}))?`, 'i')))) {\n  date = makeDate(Number(m[1]), monthNum(m[2]), m[3]);\n} else if ((m = take(new RegExp(`\\\\b(?:on\\\\s+)?(${MONTHS})\\\\s+(\\\\d{1,2})(?:st|nd|rd|th)?\\\\b(?:,?\\\\s+(\\\\d{4}))?`, 'i')))) {\n  date = makeDate(Number(m[2]), monthNum(m[1]), m[3]);\n} else if ((m = take(/\\b(?:on\\s+)?(\\d{1,2})[\\/-](\\d{1,2})(?:[\\/-](\\d{2,4}))?\\b/))) {\n  date = makeDate(Number(m[1]), Number(m[2]), m[3]);\n}\n\nif (hour === null) hour = DEFAULT_HOUR;\nif (!date) {\n  date = now.set({ hour, minute }) > now ? now : now.plus({ days: 1 });\n}\n\nconst start = date.set({ hour, minute, second: 0, millisecond: 0 });\nif (!start.isValid) return fail(\"Couldn't understand that date. Try: /task Pay GST 25/10 11am\");\n\nconst task = text.replace(/\\s+/g, ' ').replace(/^[\\s,–-]+|[\\s,–-]+$/g, '').trim();\nif (!task) return fail('What is the task? e.g. /task Call Safexpress tomorrow 3pm');\n\nconst end = start.plus({ minutes: DURATION_MIN });\n\nreturn [{ json: {\n  ok: true,\n  chatId,\n  task,\n  date: start.toFormat('yyyy-MM-dd'),\n  time: start.toFormat('HH:mm'),\n  start: start.toISO(),\n  end: end.toISO(),\n  pretty: start.toFormat('ccc d LLL, h:mm a'),\n  createdAt: now.toFormat('yyyy-MM-dd HH:mm'),\n}}];"
      },
