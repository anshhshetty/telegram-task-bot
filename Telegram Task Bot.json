    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(function (i) { return i.json; }).filter(function (r) { return Object.keys(r).length > 0; });\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nconst today = new Date(Date.now() + 330 * 60 * 1000).toISOString().slice(0, 10);\n\nconst todays = rows\n  .filter(function (r) { return String(r.Date || '').trim() === today; })\n  .sort(function (a, b) { return String(a.Time || '').localeCompare(String(b.Time || '')); });\n\nlet text;\nif (todays.length === 0) {\n  text = '🎉 Nothing on your list for today.';\n} else {\n  const lines = todays.map(function (r, idx) {\n    const status = r.Status ? ' [' + r.Status + ']' : '';\n    return (idx + 1) + '. ' + (r.Time || '--:--') + ' - ' + r.Task + status;\n  });\n  text = \"📋 Today's tasks (\" + today + \"):\\n\" + lines.join('\\n');\n}\nreturn [{ json: { chatId: chatId, text: text } }];"
      },
